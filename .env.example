# Copy to .env and adjust. Never commit real secrets.
COURTPIT_BIND=0.0.0.0:8080
DATABASE_URL=postgres://courtpit:courtpit@127.0.0.1/courtpit
RUST_LOG=info,courtpit_server=debug
# COURTPIT_LOG_FORMAT=json
# Auth
COURTPIT_SESSION_TTL_DAYS=30
COURTPIT_COOKIE_SECURE=true
COURTPIT_AUTH_IP_LIMIT_PER_HOUR=30
# COURTPIT_CLIENT_IP_SOURCE=FlyClientIp  # default ConnectInfo; set only behind a proxy you control
# Email: log (dev) | resend
COURTPIT_MAILER=log
# RESEND_API_KEY=
COURTPIT_EMAIL_FROM="Courtpit <no-reply@courtpit.app>"
# Sign in with Apple / Google (comma-separated accepted audiences; empty disables)
# COURTPIT_APPLE_CLIENT_IDS=app.courtpit.demo
# COURTPIT_GOOGLE_CLIENT_IDS=1234.apps.googleusercontent.com
# Background jobs
COURTPIT_JOBS_ENABLED=true
COURTPIT_JOB_POLL_MS=1000
# `courtpit-server tick` (scheduled Machine): runs due jobs, then exits. Stops starting jobs
# after this many seconds (a job already running is finished).
# COURTPIT_TICK_MAX_SECONDS=300
# Nightly database backups to S3-compatible storage (Cloudflare R2). Needs `pg_dump`, so the
# image must include postgresql-client. On only when endpoint, bucket and both keys are set.
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=courtpit-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=courtpit/
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=3
# Direct (non-pooled) URL for pg_dump; defaults to DATABASE_URL. On Neon the pooled `-pooler`
# URL does not work for pg_dump.
# BACKUP_DATABASE_URL=
