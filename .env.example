# Copy to .env and adjust. Never commit real secrets.
RACQUETCOLLECTIVE_BIND=0.0.0.0:8080
# Exported web app to serve beside the API (`npm run export:web` in apps/mobile); unset = API only
# RACQUETCOLLECTIVE_WEB_DIR=apps/mobile/dist
DATABASE_URL=postgres://racquetcollective:racquetcollective@127.0.0.1/racquetcollective
# Behind a transaction pooler (Neon's pooled endpoint, pgbouncer): see docs/deploy.md
# RACQUETCOLLECTIVE_DB_POOLED=false  # true: DATABASE_URL is the pooler; no sqlx statement cache
# DATABASE_DIRECT_URL=postgres://racquetcollective:racquetcollective@127.0.0.1/racquetcollective  # non-pooler; used by `migrate`
RUST_LOG=info,racquetcollective_server=debug
# RACQUETCOLLECTIVE_LOG_FORMAT=json
# Auth
RACQUETCOLLECTIVE_SESSION_TTL_DAYS=30
RACQUETCOLLECTIVE_COOKIE_SECURE=true
RACQUETCOLLECTIVE_AUTH_IP_LIMIT_PER_HOUR=30
# RACQUETCOLLECTIVE_CLIENT_IP_SOURCE=FlyClientIp  # default ConnectInfo; set only behind a proxy you control
# Email: log (dev) | resend
RACQUETCOLLECTIVE_MAILER=log
# RESEND_API_KEY=
RACQUETCOLLECTIVE_EMAIL_FROM="Racquet Collective <no-reply@racquetcollective.app>"
# Push: log (dev) | expo
RACQUETCOLLECTIVE_PUSH=log
# EXPO_ACCESS_TOKEN=
# Sign in with Apple / Google (comma-separated accepted audiences; empty disables)
# RACQUETCOLLECTIVE_APPLE_CLIENT_IDS=app.racquetcollective.demo
# RACQUETCOLLECTIVE_GOOGLE_CLIENT_IDS=1234.apps.googleusercontent.com
# Background jobs
RACQUETCOLLECTIVE_JOBS_ENABLED=true
RACQUETCOLLECTIVE_JOB_POLL_MS=1000
# `racquetcollective-server tick` (scheduled Machine): runs due jobs, then exits. Stops starting jobs
# after this many seconds (a job already running is finished).
# RACQUETCOLLECTIVE_TICK_MAX_SECONDS=300
# Nightly database backups to S3-compatible storage (Cloudflare R2). Needs `pg_dump`, so the
# image must include postgresql-client. On only when endpoint, bucket and both keys are set.
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=racquetcollective-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=racquetcollective/
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=3
# Direct (non-pooled) URL for pg_dump; defaults to DATABASE_DIRECT_URL, then DATABASE_URL. On
# Neon the pooled `-pooler` URL does not work for pg_dump.
# BACKUP_DATABASE_URL=
# Deployment environment; `racquetcollective-server seed` refuses to run when this is `production`
# RACQUETCOLLECTIVE_ENV=development
