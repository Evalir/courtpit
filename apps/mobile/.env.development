# Loaded by `expo start` (development only; `expo export` reads .env.production).
# Community slug sent as X-RacquetCollective-Community; `racquetcollective-server seed` creates `demo`.
EXPO_PUBLIC_COMMUNITY=demo
# API origin. Empty in development: requests go to the dev server, which proxies `/api` to
# RACQUETCOLLECTIVE_DEV_API (metro.config.js), so web and Expo Go both reach a local server.
EXPO_PUBLIC_API_URL=
