# Keep the build context (and so the layer cache key) down to what the build reads:
# Cargo.toml, Cargo.lock, crates/ and migrations/ for the server; the npm workspace manifests,
# apps/mobile and packages/api-client for the web export.
target/
.git/
.github/
docs/
.env
.env.*
*.md
Dockerfile
.dockerignore
fly.toml
**/node_modules/
apps/mobile/dist/
apps/mobile/.expo/
